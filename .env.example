# Copie ce fichier en ".env" (sans le ".example") et renseigne tes propres valeurs.
# Le fichier ".env" réel n'est jamais commité sur GitHub (voir .gitignore).

# OBLIGATOIRE -- chiffrement des données clients au repos (voir crypto.py).
# Génère la tienne avec :
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ne la perds jamais : sans elle, les données déjà chiffrées en base deviennent
# illisibles, y compris pour toi. Ne la partage/committe jamais.
APP_ENCRYPTION_KEY=

# Notifications Telegram (optionnel -- si absent, les notifications sont
# simplement désactivées, aucune erreur). Voir la procédure de création du
# bot dans le README pour obtenir ces deux valeurs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URL publique de la plateforme, utilisée dans le lien envoyé sur Telegram.
# Laisse la valeur par défaut tant que tu testes en local.
APP_BASE_URL=http://localhost:8000
